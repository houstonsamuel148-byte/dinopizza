import React, { useState } from 'react';
import { Menu, X, UtensilsCrossed } from 'lucide-react';
import { Page } from '../types';

interface NavbarProps {
  currentPage: Page;
  setPage: (page: Page) => void;
}

const Navbar: React.FC<NavbarProps> = ({ currentPage, setPage }) => {
  const [isOpen, setIsOpen] = useState(false);

  const navLinks: { label: string; id: Page }[] = [
    { label: 'Home', id: 'home' },
    { label: 'Menu', id: 'menu' },
    { label: 'Order', id: 'order' },
    { label: 'About', id: 'about' },
    { label: 'Contact', id: 'contact' },
  ];

  return (
    <nav className="fixed w-full z-50 bg-cream/90 backdrop-blur-md shadow-sm">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex justify-between items-center h-20">
          {/* Logo */}
          <div 
            className="flex items-center cursor-pointer group"
            onClick={() => setPage('home')}
          >
            <div className="bg-pizzaRed p-2 rounded-xl mr-2 group-hover:rotate-12 transition-transform">
              <UtensilsCrossed className="text-white" size={24} />
            </div>
            <span className="text-2xl font-extrabold tracking-tight text-charcoal">
              DINO<span className="text-pizzaRed">PIZZA</span>
            </span>
          </div>

          {/* Desktop Navigation */}
          <div className="hidden md:flex space-x-8 items-center">
            {navLinks.map((link) => (
              <button
                key={link.id}
                onClick={() => setPage(link.id)}
                className={`text-sm font-semibold transition-colors duration-200 ${
                  currentPage === link.id ? 'text-pizzaRed' : 'text-charcoal hover:text-pizzaOrange'
                }`}
              >
                {link.label}
              </button>
            ))}
            <button 
              onClick={() => setPage('order')}
              className="bg-pizzaRed text-white px-6 py-2 rounded-full font-bold hover:bg-pizzaOrange transition-colors shadow-lg shadow-pizzaRed/20"
            >
              Order Now
            </button>
          </div>

          {/* Mobile Menu Button */}
          <div className="md:hidden flex items-center">
            <button
              onClick={() => setIsOpen(!isOpen)}
              className="text-charcoal hover:text-pizzaRed transition-colors"
            >
              {isOpen ? <X size={28} /> : <Menu size={28} />}
            </button>
          </div>
        </div>
      </div>

      {/* Mobile Menu */}
      {isOpen && (
        <div className="md:hidden bg-cream border-t border-gray-100 animate-in fade-in slide-in-from-top-4 duration-300">
          <div className="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            {navLinks.map((link) => (
              <button
                key={link.id}
                onClick={() => {
                  setPage(link.id);
                  setIsOpen(false);
                }}
                className={`block w-full text-left px-4 py-3 rounded-md text-base font-bold ${
                  currentPage === link.id ? 'text-pizzaRed bg-pizzaRed/5' : 'text-charcoal hover:bg-gray-50'
                }`}
              >
                {link.label}
              </button>
            ))}
            <div className="p-4">
              <button 
                onClick={() => {
                  setPage('order');
                  setIsOpen(false);
                }}
                className="w-full bg-pizzaRed text-white py-4 rounded-xl font-black text-lg hover:bg-pizzaOrange transition-colors"
              >
                Order on WhatsApp
              </button>
            </div>
          </div>
        </div>
      )}
    </nav>
  );
};

export default Navbar;

import { MenuCategory, MenuItem } from './types';

